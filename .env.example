# Long random string. Both phones enter it once in Settings.
# Generate one with:  openssl rand -hex 24   (or any password manager)
APP_TOKEN=

# From console.anthropic.com (pay-as-you-go API, separate from a Claude.ai subscription).
# Leave empty to run without photo identification.
ANTHROPIC_API_KEY=

# Optional: override the model used for photo identification and text parsing.
# CLAUDE_MODEL=claude-opus-5-5
