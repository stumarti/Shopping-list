# Long random setup secret, entered once by the first person to connect.
# Everyone else joins with an invite link from the app.
# Generate one with:  openssl rand -hex 24   (or any password manager)
APP_TOKEN=

# ---- AI (photo identification, typed lists, price matching) ----

# From console.anthropic.com (pay-as-you-go API, separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=
# Optional overrides. Price matching reads whole search pages, so a cheaper model there saves money.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_PRICE_MODEL=claude-haiku-4-5
# CLAUDE_RECEIPT_MODEL=claude-opus-5-5

# Local model via Ollama (on this machine or another one on your network). Needs a vision model for photos.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=

# Who answers: claude | ollama | ollama-then-claude | none
# Unset: Claude if ANTHROPIC_API_KEY is set, otherwise Ollama if OLLAMA_MODEL is set.
# AI_BACKEND=ollama-then-claude

# ---- Price checks (Tesco / Dunnes), read-only ----
# Start the worker with:  docker compose --profile prices up -d
# then uncomment these two lines and restart the server.
# WORKER_URL=http://worker:8788
# WORKER_TOKEN=another-long-random-string

# Store search pages (checked October 2026). If a store changes its address, search its site for
# anything and paste that URL here with {q} in place of your search term.
# DUNNES_SEARCH_URL=https://www.dunnesstoresgrocery.com/results?q={q}
# TESCO_SEARCH_URL=https://www.tesco.ie/shop/en-IE/search?query={q}
# Seconds between searches on the same store, in milliseconds.
# STORE_GAP_MS=4000

# ---- Online ordering (same worker) ----
# Try the whole flow against the pretend store first: on the worker machine run
#   cd worker && npx tsx test/fixtures/test-store.ts      (password: correct-horse)
# TEST_STORE_URL=http://host.docker.internal:8099

# ---- Receipts ----
# Folder the server watches for old receipts (the docker-compose.yml maps ./receipts-inbox here).
RECEIPTS_INBOX=/receipts-inbox
# Whose history imported receipts count towards (a name from the app; default: the first person),
# and which list (default: the shared list).
# RECEIPTS_USER=Sam
# RECEIPTS_LIST=household
