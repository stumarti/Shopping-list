# Copy to .env (Unraid Compose Manager: the stack's "Edit Env") and change what you need.

# Port to open the list on: http://<server>:8080
PORT=8080

# Where the list is stored. Back this folder up.
DATA_DIR=/mnt/user/appdata/shopping-list

# Owner of DATA_DIR. 99:100 is Unraid's nobody:users; on other Linux machines use your own `id -u`:`id -g`.
PUID=99
PGID=100

TZ=Europe/Dublin

# Optional: the address you open the list at, e.g. https://unraid.your-tailnet.ts.net
# PUBLIC_URL=

# Optional: a password for the MCP server at /mcp, so Claude can use the list. Needed before the app is
# reachable from outside your home network (e.g. for claude.ai). Any long random string.
# MCP_TOKEN=

# Optional: only if a store changes its search page ({q} is the search term)
# TESCO_SEARCH_URL=https://www.tesco.ie/shop/en-IE/search?query={q}
# DUNNES_SEARCH_URL=https://www.dunnesstoresgrocery.com/results?q={q}
