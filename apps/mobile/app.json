{
  "expo": {
    "name": "Press",
    "slug": "press",
    "scheme": "presslist",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ie.stumarti.press",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Press syncs your list with the server on your home network."
      }
    },
    "android": {
      "package": "ie.stumarti.press",
      "adaptiveIcon": {
        "backgroundColor": "#E3EFE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Press uses the camera to scan barcodes and photograph products to add them to your list.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Press reads photos of your receipts to learn what you buy.",
          "cameraPermission": "Press uses the camera to photograph receipts and products."
        }
      ]
    ]
  }
}
